# Copy this file to .env.local and fill in the values. Never commit .env.local.

# --- Supabase (Project Settings -> API Keys / Data API) ---
# Only the base address, e.g. https://abcdefgh.supabase.co (no /rest/v1/ at the end)
NEXT_PUBLIC_SUPABASE_URL=
# "anon" / "publishable" key: safe to expose to the browser
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# "service_role" / "secret" key: server only, bypasses row level security
SUPABASE_SERVICE_ROLE_KEY=

# --- Gemini API (aistudio.google.com -> Get API key) ---
# Without it the site still works, but every AI feature is switched off.
GEMINI_API_KEY=
# Optional. Which Gemini model to use; see lib/ai/client.ts for the default.
GEMINI_MODEL=

# --- Web search for the agent (optional) ---
# Free tier at tavily.com. Without it the agent tries Gemini's own Google Search.
TAVILY_API_KEY=

# --- Daily agent ---
# Any long random string. Protects /api/agent/run from strangers.
CRON_SECRET=
# Comma-separated e-mails allowed to press "Run now" on the /agent page.
AGENT_ADMIN_EMAILS=
# Comma-separated extra pages that list activities.
SOURCE_URLS=

# --- Project inbox (optional) ---
# A dedicated Gmail address that students forward invitations to,
# and a Google "app password" for it (not the normal password).
IMAP_HOST=imap.gmail.com
IMAP_USER=
IMAP_PASS=
